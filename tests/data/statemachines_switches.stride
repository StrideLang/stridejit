_domainDefinition RootDomain {
	framework: _JitFramework
	rate: -1
    substitutions: [ ]
    domainIncludes: []
    stateMachines: [MyStateMachine]
    inputs: []
    outputs: []
	domainFunctionCode: ''
}

switch SwitchEntry { domain: RootDomain default: off }
switch SwitchProcess { domain: RootDomain default: off }
switch SwitchExit { domain: RootDomain default: off }

state Child1 {
    onEntry: [
        on >> SwitchEntry;
    ]
    onProcess: [
        on >> SwitchProcess;
    ]
    onExit: [
        on >> SwitchExit;
    ]
}
state Child2 {}

state CompositeState {
    resumeLastState: on
    initialState: Child1
    states: [Child1, Child2]
    transitions: [
        transition ToFinal {
            targetState: FinalState
            guard: [ 1 ]
        }
    ]
}

state FinalState {
    isFinal: on
}

state MyStateMachine {
    initialState: CompositeState
    states: [CompositeState, FinalState]
}
