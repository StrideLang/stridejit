_domainDefinition TestDomain {
	framework: _JitFramework
	rate: -1 # -1 is 'one-shot/final' domain
    substitutions: [ ]
    domainIncludes: []
    inputs: [
        signal InReal { domain: TestDomain type: Real }
        signal InInt { domain: TestDomain type: Int }
    ]
    outputs: [
        signal OutInt { domain: TestDomain type: Int }
        signal OutReal { domain: TestDomain type: Real }
    ]
	domainFunctionCode: ''
}

platformModule __OverloadTest@Int {
    inputs: [Int]
	outputs: [Int]
    processing: " %%outtokens:0%% = llvm::add i32 %%intokens:0%%, 2 "
    inherits: [_Signal]
}

platformModule __OverloadTest@Double {
    inputs: [Real]
	outputs: [Real]
    processing: " %%outtokens:0%% = llvm::fadd double %%intokens:0%%, 2.500000e+00 "
    inherits: [_Signal]
}

InInt >> __OverloadTest() >> OutInt;
InReal >> __OverloadTest() >> OutReal;
