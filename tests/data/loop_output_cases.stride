_domainDefinition RootDomain {
	framework: _JitFramework
	# requiresResources: [_RootContext]
	# providesResources: [_DomainFunction]
	rate: -1 # -1 is 'one-shot/final' domain
    substitutions: [ ]
    domainIncludes: []
    inputs: [ ]
    outputs: [
        signal Doubled[6] { domain: RootDomain type: Int }
        signal Slice[6] { domain: RootDomain default: -1 type: Int }
        signal Scalar { domain: RootDomain default: -1 type: Int }
        signal Sizes[5] { domain: RootDomain type: Int }
        signal Partial[3] { domain: RootDomain default: -1 type: Int }
    ]
	domainFunctionCode: ''
}

module Equal {
    ports: [
        mainOutputPort OutputPort {
            name:       'output'
            block: Output
        },
        mainInputPort InputPort {
            name:       'input'
            block: Input
			meta: "A list with the two values to be compared"
        }
    ]
    blocks: [
        signal Input[2] {domain: OutputPort.domain type: Int}
		switch Output {domain: OutputPort.domain}
    ]
    streams: [
       [Input[0], Input[1]] >> __Equal() >> Output;
    ]
    meta: "Compare two input values."
}

platformModule __Equal@Int_Bool {
    inputs: [Int, Int]
	outputs: [Switch]
#    linkTo: []
#    declarations: ['']
    # initializations: ["// CPP Greater Init"]
    processing: "%%outtokens:0%% = llvm::icmp eq %%intokens:0%%, %%intokens:1%%"
    inherits: [_Signal]
}


# Fills its output with 3 * index, as many entries as what it writes to
loop Fill {
	ports: [
		mainOutputPort OutputPort {
			block: Output
		}
	]
	blocks: [
		signal Output[OutputPort.size] { type: Int }
		signal Index { default: 0 type: Int reset: Reset }
		switch Done { default: off }
		trigger Reset {}
	]
	onExecution: Reset
	terminateWhen: Done
	streams: [
		Index * 3 >> Output[Index];
		Index + 1 >> Index;
		[ Index, OutputPort.size ] >> Equal() >> Done;
	]
}

# Doubles each entry: the input and the output are both sized by the call
loop Double {
	ports: [
		mainInputPort InputPort {
			block: Input
		}
		mainOutputPort OutputPort {
			block: Output
		}
	]
	blocks: [
		signal Input[InputPort.size] { type: Int }
		signal Output[OutputPort.size] { type: Int }
		signal Index { default: 0 type: Int reset: Reset }
		switch Done { default: off }
		trigger Reset {}
	]
	onExecution: Reset
	terminateWhen: Done
	streams: [
		Input[Index] * 2 >> Output[Index];
		Index + 1 >> Index;
		[ Index, OutputPort.size ] >> Equal() >> Done;
	]
}

# A module, not a loop, reading the size of what it writes to
module SizeOf {
	ports: [
		mainOutputPort OutputPort {
			block: Output
		}
	]
	blocks: [
		signal Output[OutputPort.size] { type: Int }
	]
	streams: [
		OutputPort.size >> Output[0];
	]
}

# Writes only Output[1]. An array output is the caller's array: its default
# is not written over the other entries
loop SetSecond {
	ports: [
		mainOutputPort OutputPort {
			block: Output
		}
	]
	blocks: [
		signal Output[OutputPort.size] { default: 9 type: Int }
		switch Done { default: off }
	]
	terminateWhen: Done
	streams: [
		5 >> Output[1];
		on >> Done;
	]
}

signal Table[6] { domain: RootDomain type: Int }

Fill() >> Table;
Table >> Double() >> Doubled;
Fill() >> Slice[2:4];
Fill() >> Scalar;
SizeOf() >> Sizes;
SetSecond() >> Partial;
