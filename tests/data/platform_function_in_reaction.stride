reaction Outer {
    ports: [
        mainOutputPort OutputPort {
            name:       'output'
            block: Output
        },
        propertyInputPort InputPort {
            name:       'input'
            block: Input
        }
    ]
    blocks: [
        signal Input {domain: OutputPort.domain type: Int}
		switch Output {domain: OutputPort.domain}
    ]
    streams: [
       Input >> __Inner() >> Output;
    ]
}

platformModule __Inner {
    inputs: [Int]
	outputs: [Switch]
#    linkTo: []
#    declarations: ['']
    # initializations: ["// CPP Greater Init"]
    processing: "%%outtokens:0%% = llvm::icmp sgt %%intokens:0%%, 6"
}
