_domainDefinition TestDomain {
	framework: _JitFramework
	# requiresResources: [_RootContext]
	# providesResources: [_DomainFunction]
	rate: -1 # -1 is 'one-shot/final' domain
    substitutions: [ ]
    domainIncludes: []
    inputs: [
        signal InReal { domain: TestDomain type: _RealType }
    ]
    outputs: [
        switch Out { domain: TestDomain }
    ]
	domainFunctionCode: ''
}

switch CompReal { domain: TestDomain }

[InReal, 0] >> Equal() >> CompReal;
