_domainDefinition RootDomain {
    framework: _JitFramework
    rate: -1
    inputs: [ signal In {domain: RootDomain type: Real } ]
    outputs: [ signal Out[2] { domain: RootDomain type: Real } ]
    domainFunctionCode: ''
}

module ModuleSimple {
    ports: [
        mainInputPort InputPort { block: Input }
        mainOutputPort OutputPort { block: Output }
        propertyInputPort FactorPort { name: "factor" block: Factor }
    ]
    blocks: [
        signal Input {domain: OutputPort.domain type:Real}
        signal Output {domain: OutputPort.domain type:Real}
        signal Factor {domain: OutputPort.domain type:Real}
    ]
    streams: [
        Input * Factor >> Output;
    ]
}

3.0 >> ModuleSimple(factor: In) >> Out[0];
In >> ModuleSimple(factor: 4.0) >> Out[1];
