
_domainDefinition RootDomain {
	framework: _JitFramework
	# requiresResources: [_RootContext]
	# providesResources: [_DomainFunction]
	rate: -1 # -1 is 'one-shot/final' domain
    substitutions: [ ]
    domainIncludes: []
    inputs: [
		signal Ints[2] {type: Int domain: RootDomain}
    ]
    outputs: [
        signal Reals[2] {type: Real domain: RootDomain}
    ]
	domainFunctionCode: ''
}

# Casting literals:
1.0 >> Ints[0];
3 >> Reals[0];
# Casting expression output
Reals[0] + 1.0 >> Ints[1];
Ints[1] + 1 >> Reals[1]; 