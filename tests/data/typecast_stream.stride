
_domainDefinition RootDomain {
	framework: _JitFramework
	# requiresResources: [_RootContext]
	# providesResources: [_DomainFunction]
	rate: -1 # -1 is 'one-shot/final' domain
    substitutions: [ ]
    domainIncludes: []
    inputs: [
		signal Int[2] {type: _IntType domain: RootDomain}
    ]
    outputs: [
        signal Real[2] {type: _RealType domain: RootDomain}
    ]
	domainFunctionCode: ''
}

# Casting literals:
1.0 >> Int[0];
3 >> Real[0];
# Casting expression output
Real[0] + 1.0 >> Int[1];
Int[1] + 1 >> Real[1]; 