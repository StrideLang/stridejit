# Test chaining code generators (reactions) directly in a stream

signal Result { type: Int }
switch Trigger { default: off }

reaction StepOne {
    ports: [
        propertyInputPort FactorPort {
            name: "factor"
            block: Factor
        }
        mainOutputPort OutPort {
            block: Intermediate
        }
    ]
    blocks: [
        signal Factor { type: Int }
        signal Intermediate { type: Int }
    ]
    streams: [
        Factor * 2 >> Intermediate;
    ]
}

reaction StepTwo {
    ports: [
        mainInputPort InPort {
            block: Input
        }
        propertyInputPort OffsetPort {
            name: "offset"
            block: Offset
        }
        mainOutputPort OutPort {
            block: Output
        }
    ]
    blocks: [
        signal Input { type: Int }
        signal Offset { type: Int }
        signal Output { type: Int }
    ]
    streams: [
        Input + Offset >> Output;
    ]
}

Trigger >> StepOne(factor: 5) >> StepTwo(offset: 10) >> Result;

