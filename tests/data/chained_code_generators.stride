# Test code generators (reactions) run by one trigger, one after the other.
# A reaction takes values through property ports, so StepOne's result reaches
# StepTwo through a signal.

signal Result { type: Int }
signal Intermediate { type: Int }
switch Trigger { default: off }

reaction StepOne {
    ports: [
        propertyInputPort FactorPort {
            name: "factor"
            entity: Factor
        }
        mainOutputPort OutPort {
            entity: Doubled
        }
    ]
    entities: [
        signal Factor { type: Int }
        signal Doubled { type: Int }
    ]
    streams: [
        Factor * 2 >> Doubled;
    ]
}

reaction StepTwo {
    ports: [
        propertyInputPort InPort {
            name: "input"
            entity: Input
        }
        propertyInputPort OffsetPort {
            name: "offset"
            entity: Offset
        }
        mainOutputPort OutPort {
            entity: Output
        }
    ]
    entities: [
        signal Input { type: Int }
        signal Offset { type: Int }
        signal Output { type: Int }
    ]
    streams: [
        Input + Offset >> Output;
    ]
}

Trigger >> StepOne(factor: 5) >> Intermediate;
Trigger >> StepTwo(input: Intermediate offset: 10) >> Result;

