
_domainDefinition RootDomain {
	framework: _JitFramework
	# requiresResources: [_RootContext]
	# providesResources: [_DomainFunction]
	rate: -1 # -1 is 'one-shot/final' domain
    substitutions: [ ]
    domainIncludes: []
    inputs: [
        signal In[16] { domain: RootDomain type: Int }
    ]
    outputs: [
        signal Out[2] { domain: RootDomain type: Int }
    ]
	domainFunctionCode: ''
}


module PortProperty {
    ports: [
        mainInputPort InputPort {
            block: Input
        }
        mainOutputPort {
            block: Output
        }
    ]
    blocks: [
        signal Input[InputPort.size] { type: Int }
        signal Output { type: Int }
    ]
    streams: [
        (Input[0] + 2) * InputPort.size >> Output;
    ]
}

signal InternalList[4] {
    default: [0, 1, 2, 3]
    domain: RootDomain
    type: Int
}

In >> PortProperty() >> Out[0];
InternalList >> PortProperty() >> Out[1];
