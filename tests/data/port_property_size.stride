
_domainDefinition TestDomain {
	framework: _JitFramework
	# requiresResources: [_RootContext]
	# providesResources: [_DomainFunction]
	rate: -1 # -1 is 'one-shot/final' domain
    substitutions: [ ]
    domainIncludes: []
    inputs: [
        signal In[16] { domain: TestDomain }
    ]
    outputs: [
        signal Out[2] { domain: TestDomain }
    ]
	domainFunctionCode: ''
}


module PortProperty {
    ports: [
        mainInputPort InputPort {
            block: Input
        }
        mainOutputPort {
            block: Output
        }
    ]
    blocks: [
        signal Input[InputPort.size] { }
        signal Output {}
    ]
    streams: [
        2.0 * InputPort.size >> Output;
    ]
}

signal InternalList[4] {
    default: [1,2,3,4]
    domain: TestDomain
}

In >> PortProperty() >> Out[0];
InternalList >> PortProperty() >> Out[1];
