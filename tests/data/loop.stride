_domainDefinition RootDomain {
	framework: _JitFramework
	# requiresResources: [_RootContext]
	# providesResources: [_DomainFunction]
	rate: -1 # -1 is 'one-shot/final' domain
    substitutions: [ ]
    domainIncludes: []
    inputs: [
		signal List[20] { default: 1 }
    ]
    outputs: [
        signal Out { domain: RootDomain }
    ]
	domainFunctionCode: ''
}

loop Add {
	ports: [
		mainInputPort InputPort {
			block: Input
		}
		mainOutputPort OutputPort {
			block: Output
		}
	]
	blocks: [
		signal Input[InputPort.size] {}
		signal Output {default: 0}
		signal Index { default: 0 type: _IntType reset: Reset }
		switch Done { default: off }
		# trigger Reset {}
	]
	# onExecution: Reset
	terminateWhen: Done
	streams: [
		Input [ Index ] + Output >> Output ;
		Index + 1 >> Index ;
		[ Index , InputPort.size ] >> Equal() >> Done ;
		
	]
}

List >> Add() >> Out;
