_domainDefinition RootDomain {
	framework: _JitFramework
	# requiresResources: [_RootContext]
	# providesResources: [_DomainFunction]
	rate: -1 # -1 is 'one-shot/final' domain
    substitutions: [ ]
    domainIncludes: []
    inputs: [
    ]
    outputs: [
        signal Out[3] { domain: RootDomain default: 0 type: _IntType }
    ]
	domainFunctionCode: ''
}

signal A[2] {type: _IntType default: [5,2] domain: RootDomain}

module Add {
    ports: [
        mainInputPort {
            block: Input
        }
        mainOutputPort {
            block: Output
        }
    ]
    blocks: [
        signal Input[2] { type: _IntType}
        signal Internal[2] {type: _IntType default: [1,2]}
        signal Output {type: _IntType}
    ]
    streams: [
        Internal[0] + Internal[1] + Input[0] + Input[1] >> Output;
    ]
}

A >> Add() >> Out[0];


module AddIntSingle {
    ports: [
        mainInputPort {
            block: Input
        }
        mainOutputPort {
            block: Output
        }
    ]
    blocks: [
        signal Input[2] { type: _IntType}
        signal Internal[2] {type: _IntType default: 3}
        signal Output {type: _IntType}
    ]
    streams: [
        Internal[0] + Internal[1] + Input[0] + Input[1] >> Output;
    ]
}

A >> AddIntSingle() >> Out[1];
