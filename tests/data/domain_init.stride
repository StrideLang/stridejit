_domainDefinition RootDomain {
	framework: _JitFramework
	# requiresResources: [_RootContext]
	# providesResources: [_DomainFunction]
	rate: -1 # -1 is 'one-shot/final' domain
    substitutions: [ ]
    domainIncludes: []
    inputs: [
    ]
    outputs: [
        signal In {type: _RealType default: 3.0 domain: RootDomain}
        signal In2 {type: _IntType default: 10 domain: RootDomain}
    ]
	domainFunctionCode: ''
}

In + 2 >> In;
In2 + 1 >> In2;