use AVR version 1.0 on ArduinoUno

# Blinks the Uno's LED (pin 13) once a second using Sleep. Compiled to IR
# on the host by JITTypeTest.AvrFrameworkTypes: AVR's Real is Float32 and
# its Int is Int16.

switch LedOn { default: off domain: AvrTickDomain }

[13, 1] >> __AvrPinMode();

LedOn >> Not() >> LedOn;
[13, LedOn] >> __AvrPinWrite();
0.1 >> Sleep(domain: AvrTickDomain);

