module Gain {
    ports: [
        mainInputPort InputPort { entity: In }
        mainOutputPort OutputPort { entity: Out }
        propertyInputPort FactorPort { name: "factor" entity: Factor }
    ]
    entities: [
        signal In     { type: Real domain: OutputPort.domain }
        signal Out    { type: Real domain: OutputPort.domain }
        signal Factor { type: Real domain: OutputPort.domain }
    ]
    streams: [
        In * Factor >> Out;
    ]
}

module Offset {
    ports: [
        mainInputPort InputPort { entity: In }
        mainOutputPort OutputPort { entity: Out }
        propertyInputPort OffsetPort { name: "offset" entity: OffsetVal }
    ]
    entities: [
        signal In        { type: Real domain: OutputPort.domain }
        signal Out       { type: Real domain: OutputPort.domain }
        signal OffsetVal { type: Real domain: OutputPort.domain }
    ]
    streams: [
        In + OffsetVal >> Out;
    ]
}
