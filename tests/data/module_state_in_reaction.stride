_domainDefinition RootDomain {
	framework: _JitFramework
	rate: -1
    substitutions: [ ]
    domainIncludes: []
    inputs: [ signal In {domain: RootDomain type: Int} ]
    outputs: [ signal Out {domain: RootDomain type: Int} ]
	domainFunctionCode: ''
}
module Counter {
    ports: [ mainInputPort InputPort { block: Input }, mainOutputPort OutputPort { block: Output } ]
    blocks: [
        signal Input { type: Int domain: OutputPort.domain }
        signal Output { type: Int domain: OutputPort.domain }
        signal Count { default: 0 type: Int reset: Reset domain: OutputPort.domain }
    ]
    streams: [
        Count + Input >> Count;
        Count >> Output;
    ]
}
reaction TestReaction {
    ports: [ propertyInputPort InputPort { name: "input" block: Input }, mainOutputPort OutputPort { block: Output } ]
    blocks: [
        signal Input { type: Int domain: OutputPort.domain }
        signal Output { type: Int domain: OutputPort.domain }
    ]
    streams: [
        Input >> Counter() >> Output;
    ]
}
# A reaction takes values through property ports; on runs it every time
on >> TestReaction(input: In) >> Out;
