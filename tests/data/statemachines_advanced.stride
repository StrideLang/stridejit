_domainDefinition RootDomain {
	framework: _JitFramework
	rate: -1
    substitutions: [ ]
    domainIncludes: []
    stateMachines: [MyStateMachine]
    inputs: []
    outputs: []
	domainFunctionCode: ''
}

signal Counter { domain: RootDomain type: _IntType default: 100 }
signal EntryCounter { domain: RootDomain type: _IntType default: 200 }
signal ExitCounter { domain: RootDomain type: _IntType default: 300 }
signal Parallel1Counter { domain: RootDomain type: _IntType default: 400 }
signal Parallel2Counter { domain: RootDomain type: _IntType default: 500 }
signal Child2Counter { domain: RootDomain type: _IntType default: 600 }

state Child1 {
    onEntry: [
        1 >> EntryCounter;
    ]
    onProcess: [
        10 >> Counter;
    ]
    onExit: [
        1 >> ExitCounter;
    ]
    transitions: [
        transition ToChild2 {
            targetState: Child2
            guard: [ 1 ]
        }
    ]
}

state Child2 {
    onProcess: [
        20 >> Child2Counter;
    ]
    transitions: [
        transition ToParallel {
            targetState: ParallelState
            guard: [ 1 ]
        }
    ]
}

state CompositeState {
    resumeLastState: on
    initialState: Child1
    states: [Child1, Child2]
    transitions: [
        transition ToFinal {
            targetState: FinalState
            guard: [ 1 ]
        }
    ]
}

state FinalState {
    isFinal: on
}

state ParallelSub1 {
    isParallel: on
    onProcess: [
        100 >> Parallel1Counter;
    ]
}

state ParallelSub2 {
    isParallel: on
    onProcess: [
        200 >> Parallel2Counter;
    ]
}

state ParallelState {
    isParallel: on
    states: [ParallelSub1, ParallelSub2]
    transitions: [
        transition ToComposite {
            targetState: CompositeState
            guard: [ 1 ]
        }
    ]
}

state MyStateMachine {
    initialState: CompositeState
    states: [CompositeState, ParallelState, FinalState]
}
