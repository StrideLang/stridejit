_domainDefinition RootDomain {
    framework: _JitFramework
    rate: -1
    outputs: [ signal Out { domain: RootDomain type: Real } ]
    domainFunctionCode: ''
}

module ModuleSimple {
    ports: [
        mainInputPort InputPort { entity: Input }
        mainOutputPort OutputPort { entity: Output }
    ]
    entities: [
        signal Input {domain: OutputPort.domain type:Real}
        signal Output {domain: OutputPort.domain type:Real}
    ]
    streams: [
        Input + 2.0 >> Output;
    ]
}

3.0 >> ModuleSimple() >> Out;
