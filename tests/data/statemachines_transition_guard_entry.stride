_domainDefinition RootDomain {
	framework: _JitFramework
	rate: -1
    substitutions: [ ]
    domainIncludes: []
    stateMachines: [MyStateMachine]
    inputs: []
    outputs: []
	domainFunctionCode: ''
}

signal InputVal { domain: RootDomain type: _IntType default: 42 }
signal TargetGuard { domain: RootDomain type: _IntType default: 0 }
signal TargetEntryRan { domain: RootDomain type: _IntType default: 0 }

state State1 {
    transitions: [
        transition ToState2 {
            targetState: State2
            guard: [ 1 ]
        }
    ]
}

state State2 {
    onEntry: [
        1 >> TargetEntryRan;
    ]
    updateGuard: [
        InputVal >> TargetGuard;
    ]
}

state MyStateMachine {
    initialState: State1
    states: [State1, State2]
}
