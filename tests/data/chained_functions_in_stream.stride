# Test chaining modules / functions in a continuous stream pipeline

signal InputValue { type: Int default: 10 }
signal OutputValue { type: Int }

module Multiply {
    ports: [
        mainInputPort InPort { entity: Input }
        propertyInputPort FactorPort { name: "factor" entity: Factor }
        mainOutputPort OutPort { entity: Output }
    ]
    entities: [
        signal Input { type: Int }
        signal Factor { type: Int }
        signal Output { type: Int }
    ]
    streams: [
        Input * Factor >> Output;
    ]
}

module AddOffset {
    ports: [
        mainInputPort InPort { entity: Input }
        propertyInputPort OffsetPort { name: "offset" entity: Offset }
        mainOutputPort OutPort { entity: Output }
    ]
    entities: [
        signal Input { type: Int }
        signal Offset { type: Int }
        signal Output { type: Int }
    ]
    streams: [
        Input + Offset >> Output;
    ]
}

module SubtractBase {
    ports: [
        mainInputPort InPort { entity: Input }
        propertyInputPort BasePort { name: "base" entity: Base }
        mainOutputPort OutPort { entity: Output }
    ]
    entities: [
        signal Input { type: Int }
        signal Base { type: Int }
        signal Output { type: Int }
    ]
    streams: [
        Input - Base >> Output;
    ]
}

InputValue >> Multiply(factor: 3) >> AddOffset(offset: 7) >> SubtractBase(base: 2) >> OutputValue;
