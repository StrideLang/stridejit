# mode is not a public buffer property in the schema
_domainDefinition BufferDom {
    framework: _JitFramework
    rate: -1
    inputs: [
        signal AudioIn { domain: BufferDom type: Real }
    ]
    outputs: [
        signal Out { domain: BufferDom type: Real }
    ]
    domainFunctionCode: ''
}

buffer InBuffer {
    type: Real
    capacity: 4
    mode: Buffer::ModeSliding
}

AudioIn >> InBuffer;
InBuffer.mode >> Out;
