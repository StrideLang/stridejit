_domainDefinition TestDomain {
	framework: _JitFramework
	# requiresResources: [_RootContext]
	# providesResources: [_DomainFunction]
	rate: -1 # -1 is 'one-shot/final' domain
    substitutions: [ ]
    domainIncludes: []
    inputs: [
        signal InInt { domain: TestDomain type: Int }
        signal InReal { domain: TestDomain type: Real }
    ]
    outputs: [
        switch Out { domain: TestDomain }
    ]
	domainFunctionCode: ''
}

switch CompInt { domain: TestDomain }
switch CompReal { domain: TestDomain }

[InInt, 0] >> Equal() >> CompInt;
[InReal, 0.0] >> Equal() >> CompReal;

