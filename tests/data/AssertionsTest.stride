# AssertionsTest.stride

_domainDefinition TestDomain {
    framework: _JitFramework
    rate: -1
    substitutions: []
    domainIncludes: []
    inputs: [
        signal In { domain: TestDomain type: _RealType }
    ]
    outputs: [
        signal Out { domain: TestDomain type: _RealType }
    ]
    domainFunctionCode: ''
}

In >> Out;

functionTest TestNear {
    target: TestDomain
    prepare: [
        [ 1.000001, 2.000002 ] >> In;
    ]
    validate: [
        [ Out, [ 1.0, 2.0 ] ] >> ExpectNear(epsilon: 0.01);
    ]
}

functionTest TestGtLt {
    target: TestDomain
    prepare: [
        [ 5.0, 10.0 ] >> In;
    ]
    validate: [
        [ Out, [ 4.0, 9.0 ] ] >> ExpectGt();
        [ Out, [ 6.0, 11.0 ] ] >> ExpectLt();
    ]
}
