_domainDefinition RootDomain {
    framework: _JitFramework
    rate: -1
    substitutions: []
    domainIncludes: []
    inputs: [
        signal List[6] { domain: RootDomain default: 1 type: Int }
    ]
    outputs: [
        signal Out { domain: RootDomain default: 0 type: Int }
    ]
    domainFunctionCode: ''
}

module Greater {
    ports: [
        mainOutputPort OutputPort {
            name: 'output'
            entity: Output
        },
        mainInputPort InputPort {
            name: 'input'
            entity: Input
        }
    ]
    entities: [
        signal Input[2] { domain: OutputPort.domain type: Int }
        switch Output { domain: OutputPort.domain }
    ]
    streams: [
        [Input[0], Input[1]] >> __Greater() >> Output;
    ]
}

platformModule __Greater@Int_Bool {
    inputs: [Int, Int]
    outputs: [Switch]
    processing: "%%outtokens:0%% = llvm::icmp sgt %%intokens:0%%, %%intokens:1%%"
    inherits: [_Signal]
}

loop Max {
    ports: [
        mainInputPort InputPort {
            entity: Input
        }
        mainOutputPort OutputPort {
            entity: Output
        }
    ]
    entities: [
        signal Input[InputPort.size] { type: Int }
        signal Output { default: 0 type: Int reset: Reset }
        iterator Item {
            entity: Input
            done: Done
        }
        trigger Reset { domain: OutputPort.domain }
        trigger Done { domain: OutputPort.domain }
    ]
    onExecution: Reset
    terminateWhen: Done
    streams: [
        [Item, Output] >> Greater() >> reaction {
            streams: [
                Item >> Output;
            ]
            domain: OutputPort.domain
        };
    ]
}

List >> Max() >> Out;
