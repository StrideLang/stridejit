# Test multi-stage triggered reaction pipeline and literal on stream. A
# reaction takes values through property ports, so each step's result reaches
# the next through a signal, and every step runs on the same trigger.

signal Result { type: Int default: 0 }
signal ResultA { type: Int default: 0 }
signal ResultB { type: Int default: 0 }
signal LiteralA { type: Int default: 0 }
signal LiteralOnResult { type: Int default: 0 }
switch Trigger { default: off }

reaction StepA {
    ports: [
        propertyInputPort FactorPort {
            name: "factor"
            block: Factor
        }
        mainOutputPort OutPort {
            block: OutA
        }
    ]
    blocks: [
        signal Factor { type: Int }
        signal OutA { type: Int }
    ]
    streams: [
        Factor * 3 >> OutA;
    ]
}

reaction StepB {
    ports: [
        propertyInputPort InPort {
            name: "input"
            block: InB
        }
        propertyInputPort OffsetPort {
            name: "offset"
            block: Offset
        }
        mainOutputPort OutPort {
            block: OutB
        }
    ]
    blocks: [
        signal InB { type: Int }
        signal Offset { type: Int }
        signal OutB { type: Int }
    ]
    streams: [
        InB + Offset >> OutB;
    ]
}

reaction StepC {
    ports: [
        propertyInputPort InPort {
            name: "input"
            block: InC
        }
        propertyInputPort MulPort {
            name: "multiplier"
            block: Multiplier
        }
        mainOutputPort OutPort {
            block: OutC
        }
    ]
    blocks: [
        signal InC { type: Int }
        signal Multiplier { type: Int }
        signal OutC { type: Int }
    ]
    streams: [
        InC * Multiplier >> OutC;
    ]
}

# 3-step pipeline guarded by Trigger: ( (5 * 3) + 5 ) * 2 = 40
Trigger >> StepA(factor: 5) >> ResultA;
Trigger >> StepB(input: ResultA offset: 5) >> ResultB;
Trigger >> StepC(input: ResultB multiplier: 2) >> Result;

# 2-step pipeline guarded by literal 'on': (4 * 3) + 8 = 20
on >> StepA(factor: 4) >> LiteralA;
on >> StepB(input: LiteralA offset: 8) >> LiteralOnResult;
