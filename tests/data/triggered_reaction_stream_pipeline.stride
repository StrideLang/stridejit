# Test multi-stage triggered reaction pipeline and literal on stream

signal Result { type: Int default: 0 }
signal LiteralOnResult { type: Int default: 0 }
switch Trigger { default: off }

reaction StepA {
    ports: [
        propertyInputPort FactorPort {
            name: "factor"
            block: Factor
        }
        mainOutputPort OutPort {
            block: OutA
        }
    ]
    blocks: [
        signal Factor { type: Int }
        signal OutA { type: Int }
    ]
    streams: [
        Factor * 3 >> OutA;
    ]
}

reaction StepB {
    ports: [
        mainInputPort InPort {
            block: InB
        }
        propertyInputPort OffsetPort {
            name: "offset"
            block: Offset
        }
        mainOutputPort OutPort {
            block: OutB
        }
    ]
    blocks: [
        signal InB { type: Int }
        signal Offset { type: Int }
        signal OutB { type: Int }
    ]
    streams: [
        InB + Offset >> OutB;
    ]
}

reaction StepC {
    ports: [
        mainInputPort InPort {
            block: InC
        }
        propertyInputPort MulPort {
            name: "multiplier"
            block: Multiplier
        }
        mainOutputPort OutPort {
            block: OutC
        }
    ]
    blocks: [
        signal InC { type: Int }
        signal Multiplier { type: Int }
        signal OutC { type: Int }
    ]
    streams: [
        InC * Multiplier >> OutC;
    ]
}

# 3-step chained pipeline guarded by Trigger: ( (5 * 3) + 5 ) * 2 = 40
Trigger >> StepA(factor: 5) >> StepB(offset: 5) >> StepC(multiplier: 2) >> Result;

# 2-step chained pipeline guarded by literal 'on': (4 * 3) + 8 = 20
on >> StepA(factor: 4) >> StepB(offset: 8) >> LiteralOnResult;
