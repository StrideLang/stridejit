_domainDefinition TestDomain {
	framework: _JitFramework
	# requiresResources: [_RootContext]
	# providesResources: [_DomainFunction]
	rate: -1 # -1 is 'one-shot/final' domain
    substitutions: [ ]
    domainIncludes: []
    inputs: [
        signal In { domain: TestDomain default: 0 type: _IntType }
    ]
    outputs: [
    ]
	domainFunctionCode: ''
}

signal A {type: _IntType default: 0 domain: TestDomain}

In >> A;
