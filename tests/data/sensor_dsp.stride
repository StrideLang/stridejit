_domainDefinition SensorDSP {
    framework: _JitFramework
    rate: -1
    inputs: [
        signal RawSensorValue { domain: SensorDSP type: Real }
        signal AlertThreshold { domain: SensorDSP type: Real }
    ]
    outputs: [
        signal FilteredValue  { domain: SensorDSP type: Real }
        switch AlertTriggered { domain: SensorDSP }
    ]
    domainFunctionCode: ''
}

module LowPassFilter {
    ports: [
        mainInputPort InputPort { 
            entity: RawIn 
        }
        mainOutputPort OutputPort { 
            entity: FilteredOut 
        }
        propertyInputPort AlphaPort { 
            name: "alpha" 
            entity: Alpha 
        }
    ]
    entities: [
        signal RawIn        { type: Real domain: OutputPort.domain }
        signal FilteredOut  { type: Real domain: OutputPort.domain }
        signal Alpha        { type: Real domain: OutputPort.domain }
        signal PrevFiltered { default: 0.0 type: Real reset: Reset domain: OutputPort.domain }
    ]
    streams: [
        (Alpha * RawIn) + ((1.0 - Alpha) * PrevFiltered) >> PrevFiltered;
        PrevFiltered >> FilteredOut;
    ]
}

module ThresholdTrigger {
    ports: [
        mainInputPort InputPort { 
            entity: Value 
        }
        mainOutputPort OutputPort { 
            entity: Triggered 
        }
        propertyInputPort ThresholdPort { 
            name: "threshold" 
            entity: Threshold 
        }
    ]
    entities: [
        signal Value       { type: Real domain: OutputPort.domain }
        signal Threshold   { type: Real domain: OutputPort.domain }
        switch Triggered   { domain: OutputPort.domain }
    ]
    streams: [
        [Value, Threshold] >> Greater() >> Triggered;
    ]
}

RawSensorValue >> LowPassFilter(alpha: 0.15) >> FilteredValue;
FilteredValue >> ThresholdTrigger(threshold: AlertThreshold) >> AlertTriggered;
