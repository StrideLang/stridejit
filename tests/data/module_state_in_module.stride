_domainDefinition RootDomain {
	framework: _JitFramework
	rate: -1
    substitutions: [ ]
    domainIncludes: []
    inputs: [ signal In {domain: RootDomain type: Int} ]
    outputs: [ signal Out {domain: RootDomain type: Int} ]
	domainFunctionCode: ''
}

module InnerAccumulator {
    ports: [ mainInputPort InputPort { entity: Input }, mainOutputPort OutputPort { entity: Output } ]
    entities: [
        signal Input { type: Int domain: OutputPort.domain }
        signal Output { type: Int domain: OutputPort.domain }
        signal Acc { default: 10 type: Int reset: Reset domain: OutputPort.domain }
    ]
    streams: [
        Acc + Input >> Acc;
        Acc >> Output;
    ]
}

module OuterModule {
    ports: [ mainInputPort InputPort { entity: Input }, mainOutputPort OutputPort { entity: Output } ]
    entities: [
        signal Input { type: Int domain: OutputPort.domain }
        signal Output { type: Int domain: OutputPort.domain }
    ]
    streams: [
        Input >> InnerAccumulator() >> Output;
    ]
}

In >> OuterModule() >> Out;
