_domainDefinition RootDomain {
	framework: _JitFramework
	# requiresResources: [_RootContext]
	# providesResources: [_DomainFunction]
	rate: -1 # -1 is 'one-shot/final' domain
    substitutions: [ ]
    domainIncludes: []
    inputs: [
    ]
    outputs: [
        switch Out { domain: RootDomain default: off }
    ]
	domainFunctionCode: ''
}

platformModule GreaterLocal@Int_Bool {
    inputs: [_IntType, _IntType]
	outputs: [_SwitchType]
#    linkTo: []
#    declarations: ['']
    # initializations: ["// CPP Greater Init"]
    processing: "%%outtokens:0%% = llvm::icmp sgt %%intokens:0%%, %%intokens:1%%"
    inherits: [_Signal]
}

signal A {type: _IntType default: 5 domain: RootDomain}
signal B {type: _IntType default: 2 domain: RootDomain}

5 >> A;
2 >> B;

[A,B] >> GreaterLocal() >> Out;
