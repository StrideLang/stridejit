_domainDefinition RootDomain {
	framework: _JitFramework
	rate: -1
    substitutions: [ ]
    domainIncludes: []
    inputs: [
		signal List[3] { domain: RootDomain default: 1 type: Int }
    ]
    outputs: [
        signal Out { domain: RootDomain type: Int }
    ]
	domainFunctionCode: ''
}

module Equal {
    ports: [
        mainOutputPort OutputPort {
            name:       'output'
            block: Output
        },
        mainInputPort InputPort {
            name:       'input'
            block: Input
			meta: "A list with the two values to be compared"
        }
    ]
    blocks: [
        signal Input[2] {domain: OutputPort.domain type: Int}
		switch Output {domain: OutputPort.domain}
    ]
    streams: [
       [Input[0], Input[1]] >> __Equal() >> Output;
    ]
    meta: "Compare two input values."
}

platformModule __Equal@Int_Bool {
    inputs: [Int, Int]
	outputs: [Switch]
    processing: "%%outtokens:0%% = llvm::icmp eq %%intokens:0%%, %%intokens:1%%"
    inherits: [_Signal]
}

loop MyLoop {
	ports: [
		mainInputPort InputPort {
			block: Input
		},
		mainOutputPort OutputPort {
			block: Output
		}
	]
	blocks: [
		signal Input[InputPort.size] { type: Int domain: OutputPort.domain }
		signal Output {default: 0 type: Int domain: OutputPort.domain }
		signal Index { default: 0 type: Int reset: Reset domain: OutputPort.domain }
		switch Done { default: off domain: OutputPort.domain }
	]
	terminateWhen: Done
	streams: [
		Input [ Index ] + Output >> Output ;
		Index + 1 >> Index ;
		[ Index , InputPort.size ] >> Equal() >> Done ;
	]
}

module TestModule {
    ports: [
        mainInputPort InputPort {
            block: Input
        },
        mainOutputPort OutputPort {
            block: Output
        }
    ]
    blocks: [
        signal Input[3] { type: Int domain: OutputPort.domain }
        signal Output { type: Int domain: OutputPort.domain }
    ]
    streams: [
        Input >> MyLoop() >> Output;
    ]
}

List >> TestModule() >> Out;
