_domainDefinition TestDomain {
	framework: _JitFramework
	# requiresResources: [_RootContext]
	# providesResources: [_DomainFunction]
	rate: -1 # -1 is 'one-shot/final' domain
    substitutions: [ ]
    domainIncludes: []
    inputs: [
    ]
    outputs: [
        signal Out { domain: TestDomain }
    ]
	domainFunctionCode: ''
}

module AddTwo {
    ports: [
        mainInputPort {
            block: Input
        }
        mainOutputPort {
            block: Output
        }
    ]
    blocks: [
        signal Input {}
        signal Output {}
    ]
    streams: [
        Input + 2.0 >> Output;
    ]
}

3.0 >> AddTwo() >> Out;
