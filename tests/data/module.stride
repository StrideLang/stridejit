# No system, so we need to call it RootDomain
_domainDefinition RootDomain {
	framework: _JitFramework
	# requiresResources: [_RootContext]
	# providesResources: [_DomainFunction]
	rate: -1 # -1 is 'one-shot/final' domain
    substitutions: [ ]
    domainIncludes: []
    inputs: [
    ]
    outputs: [
        signal Out { domain: RootDomain type: _RealType}
    ]
	domainFunctionCode: ''
}

alias PlatformDomain {
    block: RootDomain
}

module AddTwo {
    ports: [
        mainInputPort InputPort {
            block: Input
        }
        mainOutputPort OutputPort {
            block: Output
        }
    ]
    blocks: [
        signal Input {domain: OutputPort.domain type:OutputPort.type}
        signal Output {domain: OutputPort.domain type:OutputPort.type}
    ]
    streams: [
        Input + 2.0 >> Output;
    ]
}

3.0 >> AddTwo() >> Out;
