
_domainDefinition RootDomain {
	framework: _JitFramework
	# requiresResources: [_RootContext]
	# providesResources: [_DomainFunction]
	rate: -1 # -1 is 'one-shot/final' domain
    substitutions: [ ]
    domainIncludes: []
    inputs: [
        signal In { domain: RootDomain type: _RealType }
    ]
    outputs: [
        switch Out { domain: RootDomain type: _SwitchType }
    ]
	domainFunctionCode: ''
}

[In, 2.0] >> Greater() >> Out;