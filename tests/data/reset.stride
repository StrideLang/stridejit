
_domainDefinition RootDomain {
	framework: _JitFramework
	# requiresResources: [_RootContext]
	# providesResources: [_DomainFunction]
	rate: -1 # -1 is 'one-shot/final' domain
    substitutions: [ ]
    domainIncludes: []
    inputs: [
        signal In {default: 3.0 type: _RealType reset: Reset domain: RootDomain}
    ]
    outputs: [
        signal Count {default: 0 type: _IntType reset: Reset domain: RootDomain}
    ]
	domainFunctionCode: ''
}

trigger Reset {default: off  domain: RootDomain}

[Count, 5] >> Equal() >> Reset;
In + 2 >> In;
Count + 1 >> Count;