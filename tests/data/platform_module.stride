_domainDefinition TestDomain {
	framework: _JitFramework
	# requiresResources: [_RootContext]
	# providesResources: [_DomainFunction]
	rate: -1 # -1 is 'one-shot/final' domain
    substitutions: [ ]
    domainIncludes: []
    inputs: [
        signal InReal { domain: TestDomain type: _RealType }
        signal InInt { domain: TestDomain type: _IntType }
    ]
    outputs: [
        switch Out { domain: TestDomain }
    ]
	domainFunctionCode: ''
}

signal OutInt { domain: TestDomain type: _IntType }
signal OutReal { domain: TestDomain type: _RealType }
signal OutWrapped { domain: TestDomain type: _RealType }


platformModule __Test1 {
    inputs: [_IntType]
	outputs: [_IntType]
#    linkTo: []
#    declarations: ['']
    # initializations: ["// CPP Equal Init"]
    processing: " = "
    inherits: [_Signal]
}

platformModule __Test2 {
    inputs: [_RealType]
	outputs: [_RealType]
#    linkTo: []
#    declarations: ['']
    # initializations: ["// CPP Equal Init"]
    processing: " %%outtokens:0%% = llvm::fadd float %%intokens:0%%, 2.500000e+00 "
    inherits: [_Signal]
}

module Wrapper {
    ports: [
        mainInputPort InputPort {
            block: Input
        }
        mainOutputPort OutputPort {
            block: Output
        }
    ]
    blocks: [
        signal Input {domain: OutputPort.domain type: _RealType}
        signal Output {domain: OutputPort.domain type: _RealType}
    ]
    streams: [
        Input >> __Test2() >> Output;
    ]
}

InInt >> __Test1() >> OutInt;
InReal >> __Test2() >> OutReal;
InReal >> Wrapper() >> OutWrapped;