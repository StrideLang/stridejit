# Tests for Stride String Support

_domainDefinition RootDomain {
    framework: _JitFramework
    rate: -1
    substitutions: [ ]
    domainIncludes: []
    inputs: [
        string InStr { domain: RootDomain }
        string PaddedStr { domain: RootDomain }
    ]
    outputs: [
        string OutLiteral { domain: RootDomain }
        string OutSub { domain: RootDomain }
        string OutTrim { domain: RootDomain }
        signal OutPos { domain: RootDomain type: Int }
        switch OutStarts { domain: RootDomain }
        switch OutEnds { domain: RootDomain }
        switch OutContains { domain: RootDomain }
        switch OutEqual { domain: RootDomain }
        signal OutCmp { domain: RootDomain type: Int }
        signal OutLen { domain: RootDomain type: Int }
        switch OutEmpty { domain: RootDomain }
        signal OutInt { domain: RootDomain type: Int }
        signal OutReal { domain: RootDomain type: Real }
        string OutArrayElem { domain: RootDomain }
        string OutConcat { domain: RootDomain }
        string OutArraySub { domain: RootDomain }
        string OutConcat3 { domain: RootDomain }
        string OutConcat5 { domain: RootDomain }
        string OutConcat7 { domain: RootDomain }
        string OutPlus { domain: RootDomain }
        string OutRepeat { domain: RootDomain }
        signal OutTokCount { domain: RootDomain type: Int }
        string OutTok1 { domain: RootDomain }
        string OutFmt1 { domain: RootDomain }
        string OutFmt2 { domain: RootDomain }
        string OutConstStr { domain: RootDomain }
        string OutConstCat { domain: RootDomain }
        string OutConstFmt { domain: RootDomain }
    ]
    domainFunctionCode: ''
}

# 1. String literal assignment
"Constant Message" >> OutLiteral;

# 2. Substring extraction (start: 0, len: 5)
[ InStr, 0, 5 ] >> Substring() >> OutSub;

# 3. Trim whitespace
[ PaddedStr, " " ] >> Trim() >> OutTrim;

# 4. Find needle "World" starting at 0
[ InStr, "World", 0 ] >> Find() >> OutPos;

# 5. StartsWith "Hello"
[ InStr, "Hello" ] >> StartsWith() >> OutStarts;

# 6. EndsWith "World"
[ InStr, "World" ] >> EndsWith() >> OutEnds;

# 7. Contains "lo Wo"
[ InStr, "lo Wo" ] >> Contains() >> OutContains;

# 8. Equal to "Hello World"
[ InStr, "Hello World" ] >> Equal() >> OutEqual;

# 9. Compare with "Hello World" (should be 0)
[ InStr, "Hello World" ] >> Compare() >> OutCmp;

# 10. Length
InStr >> Length() >> OutLen;

# 11. IsEmpty
InStr >> IsEmpty() >> OutEmpty;

# 12. Parse numbers
[ "12345", 0 ] >> Parse() >> OutInt;
[ "98.765", 0.0 ] >> Parse() >> OutReal;

# 13. Concat two strings
[ "Hello, ", "World!" ] >> Concat() >> OutConcat;

# 14. PrintLn (sink)
OutConcat >> PrintLn();

# 15. Array of strings and array indexing as struct_out destination
string StrArray[3] { domain: RootDomain }

"First" >> StrArray[0];
"Second" >> StrArray[1];
"Third" >> StrArray[2];

# Write Substring directly into array element StrArray[2]
[ InStr, 0, 5 ] >> Substring() >> StrArray[2];

StrArray[1] >> OutArrayElem;
StrArray[2] >> OutArraySub;

# 16. Multi-argument concat
[ "A", "B", "C" ] >> Concat() >> OutConcat3;
[ "1", "2", "3", "4", "5" ] >> Concat() >> OutConcat5;
[ "A", "B", "C", "D", "E", "F", "G" ] >> Concat() >> OutConcat7;

# 17. Binary string addition sugar
"Hello " + "World" >> OutPlus;

# 18. Repeat
[ "=", 5 ] >> Repeat() >> OutRepeat;

# 19. Tokenization queries
[ "alpha,beta,gamma", "," ] >> TokenCount() >> OutTokCount;
[ "alpha,beta,gamma", ",", 1 ] >> TokenAt() >> OutTok1;

# 20. Format (template placeholder formatting)
[ "Player {}: Score {:04d}, HP {:.1f}%, Alive {}", "Hero", 42, 98.6, on ] >> Format() >> OutFmt1;
[ "Boss", 9000 ] >> Format(format: "[{}] Power: {:d}") >> OutFmt2;

# 21. Constant with string value
constant Greeting { value: "Greetings" }

Greeting >> OutConstStr;
[ Greeting, ", ", InStr ] >> Concat() >> OutConstCat;
[ Greeting, 7 ] >> Format(format: "{} #{}!") >> OutConstFmt;
