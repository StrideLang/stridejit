

_domainDefinition RootDomain {
	framework: _JitFramework
	# requiresResources: [_RootContext]
	# providesResources: [_DomainFunction]
	rate: -1 # -1 is 'one-shot/final' domain
    substitutions: [ ]
    domainIncludes: []
    inputs: [
    ]
    outputs: [
        signal S { domain: RootDomain type: _RealType}
        signal Counter { domain: RootDomain type: _IntType}
    ]
	domainFunctionCode: ''
}

reaction Reaction { 
    streams: [
        S + 3.0 >> S;
    ]
    domain: RootDomain
}

[Counter, 0] >> Greater() >> Reaction();
Counter + 1 >> Counter;