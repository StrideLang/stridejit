# A buffer can't be read by name; Buf.frame is the peek
_domainDefinition BufferDom {
    framework: _JitFramework
    rate: -1
    inputs: [
        signal AudioIn { domain: BufferDom type: Real }
    ]
    outputs: [
        signal Snapshot[4] { domain: BufferDom type: Real }
        signal Count { domain: BufferDom type: Int }
    ]
    domainFunctionCode: ''
}

buffer InBuffer {
    type: Real
    capacity: 8
    frameSize: 4
    hop: 2
}

AudioIn >> InBuffer;
InBuffer >> Snapshot;
InBuffer.count >> Count;
