
_domainDefinition TestDomain {
	framework: _JitFramework
	# requiresResources: [_RootContext]
	# providesResources: [_DomainFunction]
	rate: -1 # -1 is 'one-shot/final' domain
    substitutions: [ ]
    domainIncludes: []
    inputs: [
    ]
    outputs: [
        signal Out { domain: TestDomain type: _RealType }
        signal Counter { domain: TestDomain type: _RealType }
    ]
	domainFunctionCode: ''
}

reaction Reaction { 
    streams: [
        Out + 3.0 >> Out;
    ]
    domain: TestDomain
}


[Counter, 0.0] >> Greater() >> Reaction();
Counter + 1.0 >> Counter;