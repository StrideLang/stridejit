_domainDefinition TestDomain {
	framework: _JitFramework
	# requiresResources: [_RootContext]
	# providesResources: [_DomainFunction]
	rate: -1 # -1 is 'one-shot/final' domain
    substitutions: [ ]
    domainIncludes: []
    inputs: [
    ]
    outputs: [
        signal Out { domain: TestDomain default: 0 type: _IntType }
    ]
	domainFunctionCode: ''
}

signal A {type: _IntType default: 5 domain: TestDomain}

A + 1 >> Out;
