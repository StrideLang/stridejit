_domainDefinition TestDomain {
	framework: _JitFramework
	# requiresResources: [_RootContext]
	# providesResources: [_DomainFunction]
	rate: -1 # -1 is 'one-shot/final' domain
    substitutions: [ ]
    domainIncludes: []
    inputs: [
    ]
    outputs: [
        signal Out { domain: TestDomain type: Real}
    ]
	domainFunctionCode: ''
}

module AddTwo {
    ports: [
        mainInputPort {
            block: Input
        }
        mainOutputPort {
            block: Output
        }
    ]
    blocks: [
        signal Input { type: Real }
        signal Output { type: Real }
        signal Internal { type: Real }
    ]
    streams: [
        2.0 >> Internal;
        Internal + Input >> Output;
    ]
}

3.0 >> AddTwo() >> Out;
